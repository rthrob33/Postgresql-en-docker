{
  "name": "postgresql-en-docker",
  "version": "1.0.0",
  "description": "PostgreSQL en Docker con esquema en Drizzle, migración, seed y un servicio de tareas",
  "author": "Roberth Melendez (carnet 2500461)",
  "license": "ISC",
  "scripts": {
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:generar": "drizzle-kit generate",
    "db:migrar": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.11",
    "typescript": "^5.6.0"
  }
}
